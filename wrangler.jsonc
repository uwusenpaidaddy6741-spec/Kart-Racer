{
  "name": "kart-racer",
  "main": "worker.js",
  "compatibility_date": "2026-09-12",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "MY_DB",
      "database_name": "kart-racer-leaderboard",
      "database_id": "e3db849e-5c65-42bb-afe2-076965470546"
    }
  ]
}
